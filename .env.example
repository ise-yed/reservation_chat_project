
# Django
SECRET_KEY=change-me-use-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - PostgreSQL
DB_NAME=reservation_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Frontend
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Email - Development can use console backend from config/settings/dev.py
# Production SMTP settings are used by config/settings/prod.py
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=noreply@example.com

# Optional local command usage
# DJANGO_SETTINGS_MODULE=config.settings.dev
